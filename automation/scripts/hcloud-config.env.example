# Hetzner K3S Server Creation Configuration Template
#
# Copy this file to hcloud-config.env and customize for your environment
# Then run: ./hcloud-create-servers.sh
#
# IMPORTANT: Never commit actual credentials to version control!
# Use environment variables or secure credential managers instead.

###############################################################################
# CREDENTIALS (REQUIRED)
###############################################################################
# Set via environment: export HCLOUD_TOKEN="your-token"
# Or in ~/.config/hetzner/runtime.env
# Never set here in version-controlled files!

###############################################################################
# K3S MASTER (CONTROL PLANE) CONFIGURATION
###############################################################################

# Number of master nodes (recommend: 1, 3, or 5 for HA)
# - 1: Single master (development/testing only)
# - 3: HA cluster with etcd quorum
# - 5: Larger HA cluster with better resilience
MASTER_COUNT=3

# Server type — see https://www.hetzner.com/cloud/cost-optimized for current list
# Cost-optimized CX types (Intel/AMD):
# - cx23: 2 vCPU, 4GB RAM, 40GB SSD — €5.99/mo (dev/test)
# - cx33: 4 vCPU, 8GB RAM, 80GB SSD — €8.99/mo (recommended for production)
# - cx43: 8 vCPU, 16GB RAM, 160GB SSD — €16.49/mo (larger clusters)
# - cx53: 16 vCPU, 32GB RAM, 240GB SSD — €29.99/mo
# ARM-based CAX types:
# - cax11: 2 Ampere vCPU, 4GB RAM, 40GB SSD — €6.49/mo
# - cax21: 4 Ampere vCPU, 8GB RAM, 80GB SSD — €10.99/mo
# - cax31: 8 Ampere vCPU, 16GB RAM, 160GB SSD — €21.49/mo
MASTER_TYPE="cx33"

# Image to use (snapshot ID, snapshot name, or official image ID)
# Examples:
# - "microos-snapshot" (recommended, if you created a snapshot)
# - "312611387" (specific snapshot ID)
# - See: hcloud image list --type system
MASTER_IMAGE="microos-snapshot"

# Locations for master nodes (can span multiple datacenters for resilience)
# Available: fsn1 (Falkenstein), nbg1 (Nuremberg), hel1 (Helsinki), 
#            ash (Ashburn VA), sin (Singapore), sgp (Singapore)
# Can also add: sjc (San Jose), hio (Tokyo)
MASTER_LOCATIONS=("nbg1" "fsn1" "hel1")

# Rotate master locations across the array (1=yes, 0=no)
# - 1: Master 1 in nbg1, Master 2 in fsn1, Master 3 in hel1
# - 0: All masters in first location (nbg1)
MASTER_ROTATE_LOCATIONS=0

###############################################################################
# K3S WORKER (AGENT) CONFIGURATION
###############################################################################

# Number of worker nodes (minimum 1, recommend 2-3 for production)
WORKER_COUNT=2

# Server type for workers (can be different from masters)
# Same options as MASTER_TYPE above, plus GPU types:
# - gx211: GPU (NVIDIA L4, 24GB VRAM) for ML workloads
# - gx311: GPU (NVIDIA L40S, 48GB VRAM) for ML workloads
WORKER_TYPE="cx33"

# Image for worker nodes
WORKER_IMAGE="microos-snapshot"

# Locations for worker nodes (can be different from masters)
# Spread across locations for availability
WORKER_LOCATIONS=("nbg1" "fsn1" "hel1")

# Rotate worker locations (1=yes, 0=no)
# If 0, workers default to second location in array (fsn1)
WORKER_ROTATE_LOCATIONS=1

###############################################################################
# NETWORKING & CONNECTIVITY
###############################################################################

# Private network for internal cluster communication
# This network connects masters and workers securely
# Create in Hetzner console: Project -> Networking -> Networks
# Then enable vSwitch for physical server connectivity
PRIVATE_NETWORK="runtime-net"

# Attach servers to private network (1=yes, 0=no)
# Recommended: 1 (for production clusters)
ATTACH_TO_NETWORK=1

###############################################################################
# SSH & SECURITY
###############################################################################

# SSH key name in Hetzner (must already exist in your project)
# Create in console: Project -> Security -> SSH Keys
# Then: hcloud ssh-key list (to verify)
SSH_KEY="k3s-admin"

###############################################################################
# SERVER LIFECYCLE MANAGEMENT
###############################################################################

# RECREATE_CLUSTER=1: Delete ALL masters + workers, then recreate from config (full rebuild)
# INCREASE_WORKERS=1: Keep existing servers, only add new workers up to WORKER_COUNT
RECREATE_CLUSTER=0
INCREASE_WORKERS=0

###############################################################################
# TAGGING & MANAGEMENT
###############################################################################

# Tag applied to all created servers (for organization and automation)
CLUSTER_TAG="k3s-cluster"

# Environment label (e.g., production, staging, development)
ENVIRONMENT_TAG="production"

###############################################################################
# OUTPUT & INTEGRATION
###############################################################################

# Export IPs to shell variables file (for Ansible inventory)
EXPORT_IPS_FILE="hcloud_server_ips.env"

# Export as Ansible inventory YAML (optional)
# Leave empty to skip YAML export, or set filename
EXPORT_YAML_FILE="hcloud_servers_inventory.yml"

###############################################################################
# OPTIONAL COMPONENTS
###############################################################################

# Create a Hetzner Load Balancer for the K3s API after server creation
# - 1: Create LB (recommended for production HA — see load-balancer.md)
# - 0: Skip (use direct master IP for API access)
CREATE_LB=0

# Load balancer type (lb11=€7.49/mo, lb21=€21.49, lb31=€42.99)
LB_TYPE="lb11"

# Deploy Rancher for cluster management after cluster setup
# - 1: Deploy Rancher (cert-manager + Helm)
# - 0: Skip
INSTALL_RANCHER=0

# Rancher initial admin password (only used when INSTALL_RANCHER=1)
RANCHER_PASSWORD=""

###############################################################################
# TIMING & API RATE LIMITING
###############################################################################

# Seconds to wait between API calls (avoid rate limits)
API_RATE_LIMIT_DELAY=5

# Maximum seconds to wait for a server to reach "running" status
POLL_TIMEOUT=300

# Interval between status checks (seconds)
POLL_INTERVAL=5

###############################################################################
# WORKFLOW EXAMPLE
###############################################################################
# 
# 1. Ensure HCLOUD_TOKEN is set:
#    export HCLOUD_TOKEN="$(cat ~/.config/hetzner/runtime.env | grep HCLOUD_TOKEN | cut -d= -f2)"
#
# 2. Create MicroOS snapshot (if not already done):
#    See docs/runbooks/hetzner-from-scratch.md section 4
#
# 3. Run script with this config:
#    ./hcloud-create-servers.sh
#
# 4. Wait for server creation (5-10 minutes):
#    watch -n 5 'hcloud server list'
#
# 5. Source the exported IPs:
#    source hcloud_server_ips.env
#    echo "Master 1 IP: $IP_MASTER_1"
#
# 6. Run Ansible bootstrap:
#    ansible-playbook -i hcloud_servers_inventory.yml automation/ansible/playbooks/bootstrap-os.yml
#    ansible-playbook -i hcloud_servers_inventory.yml automation/ansible/playbooks/install-k3s-servers.yml
#    ansible-playbook -i hcloud_servers_inventory.yml automation/ansible/playbooks/install-k3s-agents.yml
#
# 7. Verify cluster:
#    kubectl get nodes
#
###############################################################################
