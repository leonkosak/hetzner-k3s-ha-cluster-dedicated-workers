hcloud_token        = "replace_me"
cluster_name        = "runtime"
location            = "nbg1"
network_zone        = "eu-central"
control_plane_count = 3
control_plane_type  = "cpx31"
# Use a Hetzner Cloud snapshot name or ID created from openSUSE MicroOS.
image               = "microos-snapshot"
network_cidr        = "10.80.0.0/16"
subnet_cidr         = "10.80.10.0/24"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

api_allowed_cidrs = [
  "203.0.113.10/32"
]
